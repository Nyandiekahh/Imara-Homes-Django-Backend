APP_NAME=ImaraHomes
DJANGO_SECRET_KEY=replace-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3
DATABASE_URL=
DJANGO_DB_CONN_MAX_AGE=600
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# Frontend origin, used to build links inside emails/SMS (invitations, resets)
FRONTEND_BASE_URL=http://localhost:3000

# --- Email (SMTP) ---------------------------------------------------------
# Leave EMAIL_HOST blank to use the console backend (emails print to the
# server log) during local development. Any real SMTP provider works
# (Gmail SMTP, SendGrid, Mailgun, Zoho, etc.).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=ImaraHomes <no-reply@imarahomes.co.ke>

# --- M-Pesa Daraja (Safaricom) --------------------------------------------
# Get sandbox credentials at https://developer.safaricom.co.ke
# Leave MPESA_CONSUMER_KEY/SECRET blank to use the built-in dev simulation.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS URL Safaricom can reach (e.g. your Render URL) — required for real STK pushes.
MPESA_CALLBACK_BASE_URL=
# Optional shared secret appended to the callback URL as ?secret=... for basic authenticity checking.
MPESA_CALLBACK_SECRET=
MPESA_ACCOUNT_REFERENCE=ImaraHomes

# --- SMS (Africa's Talking) ------------------------------------------------
# Get sandbox credentials at https://account.africastalking.com
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_ENV=sandbox

# --- Kenyan rental-income reporting defaults (per-property overridable) ---
DEFAULT_EXPENDITURE_RATE_PERCENT=40.00
DEFAULT_RENTAL_TAX_RATE_PERCENT=10.00
